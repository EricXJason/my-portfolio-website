# ============================================================================
# Environment Variables Example (.env.example)
# Project: Portfolio Website (許哲誠個人官方作品集與 CMS 內容管理系統)
# Author: HSU, CHE-CHENG (許哲誠)
# ============================================================================

# 應用程式環境 (development / production)
VITE_APP_ENV=development

# 站點基本設定 (Base URL)
VITE_BASE_URL=http://localhost:5500/

# Firebase 後端認證與資料庫配置 (預備串接)
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
# VITE_FIREBASE_APP_ID=your-app-id
